using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
    title: _("BakeryOS Dev Wizard");
    default-width: 900;
    default-height: 650;

    content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            [end]
            Gtk.ToggleButton search_button {
                icon-name: "system-search-symbolic";
                tooltip-text: _("Search packages");
            }
        }

        [top]
        Gtk.SearchBar search_bar {
            search-mode-enabled: bind search_button.active bidirectional;
            child: Gtk.SearchEntry search_entry {
                placeholder-text: _("Search packages…");
                hexpand: true;
                max-width-chars: 35;
                width-request: 230;
            };
        }

        content: Gtk.Box {
            orientation: vertical;
            vexpand: true;
            hexpand: true;
            margin-top: 20;
            margin-bottom: 20;
            margin-start: 20;
            margin-end: 20;
            spacing: 15;

            Gtk.Stack content_stack {
                vexpand: true;
                hexpand: true;
                transition-type: crossfade;

                Gtk.StackPage {
                    name: "categories";
                    child: Gtk.Box {
                        orientation: vertical;
                        vexpand: true;
                        hexpand: true;
                        spacing: 15;

                        Adw.ViewSwitcher view_switcher {
                            stack: stack;
                            halign: center;
                            policy: wide;
                        }

                        Adw.ViewStack stack {
                            vexpand: true;
                            hexpand: true;

                Adw.ViewStackPage {
                    name: "code_editor";
                    title: _("Code Editors");
                    icon-name: "applications-development-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox code_editor_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }

                Adw.ViewStackPage {
                    name: "programming_language";
                    title: _("Languages");
                    icon-name: "utilities-terminal-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox programming_language_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }

                Adw.ViewStackPage {
                    name: "framework";
                    title: _("Frameworks");
                    icon-name: "package-x-generic-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox framework_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }

                Adw.ViewStackPage {
                    name: "tooling";
                    title: _("Toolings");
                    icon-name: "applications-system-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox tooling_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }

                Adw.ViewStackPage {
                    name: "ai_agent";
                    title: _("AI Agents");
                    icon-name: "cpu-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox ai_agent_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }

                Adw.ViewStackPage {
                    name: "browser";
                    title: _("Browsers");
                    icon-name: "web-browser-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox browser_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }

                Adw.ViewStackPage {
                    name: "other";
                    title: _("Other");
                    icon-name: "view-app-grid-symbolic";

                    child: Gtk.ScrolledWindow {
                        vexpand: true;
                        hexpand: true;

                        child: Gtk.FlowBox other_packages {
                            valign: start;
                            hexpand: true;
                            homogeneous: true;

                            row-spacing: 12;
                            column-spacing: 12;

                            min-children-per-line: 3;
                            max-children-per-line: 3;

                            selection-mode: none;
                        };
                    };
                }
                        }
                    };
                }

                Gtk.StackPage {
                    name: "search";
                    child: Gtk.Box {
                        orientation: vertical;
                        vexpand: true;
                        hexpand: true;
                        spacing: 10;

                        Gtk.Label search_summary_label {
                            halign: start;
                            margin-start: 4;
                            styles [
                                "dim-label",
                            ]
                        }

                        Gtk.Stack search_result_stack {
                            vexpand: true;
                            hexpand: true;
                            transition-type: crossfade;

                            Gtk.StackPage {
                                name: "results";
                                child: Gtk.ScrolledWindow {
                                    vexpand: true;
                                    hexpand: true;

                                    child: Gtk.FlowBox search_packages {
                                        valign: start;
                                        hexpand: true;
                                        homogeneous: true;

                                        row-spacing: 12;
                                        column-spacing: 12;

                                        min-children-per-line: 3;
                                        max-children-per-line: 3;

                                        selection-mode: none;
                                    };
                                };
                            }

                            Gtk.StackPage {
                                name: "empty";
                                child: Adw.StatusPage search_empty_page {
                                    icon-name: "system-search-symbolic";
                                    title: _("No Packages Found");
                                    description: _("Try searching with different keywords");
                                    vexpand: true;
                                    hexpand: true;
                                };
                            }
                        }
                    };
                }
            }

            Gtk.Button install_button {
                label: "Install Selected Packages";
                css-classes: ["suggested-action", "pill"];
                halign: center;
            }
        };
    };
}
