  {
    "id": "sublime-text",
    "name": "Sublime Text",
    "description": "Text Editing, Done Right.",
    "icon": "",
    "group": "code_editor",
    "url": "https://www.sublimetext.com/",
    "install_steps": [
      {
        "type": "run_custom_script",
        "data": {
          "script": "curl -O https://download.sublimetext.com/sublimehq-pub.gpg"
        }
      },
      {
        "type": "run_custom_script",
        "data": {
          "script": "export SUDO_ASKPASS=\"/usr/local/bin/bakeryos-dev-wizard-askpass.sh\" &&  sudo -A pacman-key --add sublimehq-pub.gpg && sudo -A pacman-key --lsign-key 8A8F901A && rm sublimehq-pub.gpg"
        }
      },
      {
        "type": "run_custom_script",
        "data": {
          "script": "export SUDO_ASKPASS=\"/usr/local/bin/bakeryos-dev-wizard-askpass.sh\" &&  echo -e \"\\n[sublime-text]\\nServer = https://download.sublimetext.com/arch/stable/x86_64\" | sudo -A tee -a /etc/pacman.conf"
        }
      },
      {
        "type": "run_custom_script",
        "data": {
          "script": "export SUDO_ASKPASS=\"/usr/local/bin/bakeryos-dev-wizard-askpass.sh\" && sudo -A pacman -Syu --noconfirm sublime-text"
        }
      }
    ]
  },
